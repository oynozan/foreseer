# Copy to server/.env. Never commit the real file.
# The server refuses to start on the published dev defaults unless
# FORESEER_ALLOW_DEV_DEFAULTS=1 is set, which is for throwaway local runs only.

PORT=8787
FORESEER_DB=data/foreseer.db

# Admin credential for POST /admin/*. Generate: openssl rand -hex 24
FORESEER_ADMIN_KEY=

# Receipt signing identity. Its address MUST equal the teeId the deployed
# ForeseerInstructionSender was constructed with, or anchorEpoch reverts.
# Generate a fresh 32 byte hex key, never reuse the spec reference key.
FORESEER_TEE_KEY=

# Epoch length in seconds. The revealed seed lands one epoch after a bet.
FORESEER_EPOCH_SECONDS=300

# Billing. Price 0 means free plays and no prepaid gate.
FORESEER_PRICE_PER_PLAY_WEI=10000000000000000
FORESEER_TREASURY=
FORESEER_CHAIN_RPC=https://coston2-api.flare.network/ext/C/rpc

# Per-operator rate limit on POST /play
FORESEER_PLAY_LIMIT=60
FORESEER_PLAY_WINDOW_SECONDS=10
